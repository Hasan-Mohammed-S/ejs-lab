<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Category</title>
</head>

<body>
    <h1>Category Page</h1>
    <%- include('./partials/nav') %>

        <ul>
            <% filteredMenu.forEach((item) => { %>
                <li>
                    <%= item.name%>:
                        <%= item.price%>:
                            <%= item.rating%>:
                                <%= item.details %>

                </li>
                <% }); %>
        </ul>




</body>

</html>